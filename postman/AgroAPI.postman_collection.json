    {
      "name": "02 - Padron y perfil",
      "item": [
        {
          "name": "Lotes - guardar ids",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/lotes?pagina=0&tamanio=100",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenTecnico}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const lotes = pm.response.json().contenido;",
                  "const abiertos = lotes.filter(x => !x.campaniaCerrada);",
                  "pm.collectionVariables.set(\"loteId\", abiertos[0].id);",
                  "pm.collectionVariables.set(\"loteSinCosechaId\", abiertos.find(x => x.codigo === \"LOT-002\")?.id || abiertos[1].id);",
                  "pm.collectionVariables.set(\"loteCerradoId\", lotes.find(x => x.campaniaCerrada).id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle",
